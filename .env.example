# Copy to .env.local and fill in. README.md tells you to do this; the file was
# missing until 2026-07-30.
#
# THREE ENVIRONMENTS
#   production  ysmwowzxkgisshaormmf  — Vercel Production scope
#   cert        gzrukevymmguqxuoynqk  — Vercel Preview scope AND local dev
#   (there is no separate throwaway sandbox; cert holds real prod data)
#
# Cert is a faithful copy of production INCLUDING PHI. See
# scripts/cert-refresh/README.md before pointing anything at it.

# --- Required (validateEnv fails production boot without these) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# PHI encryption. Generate with: openssl rand -hex 32
# NEVER use a NEXT_PUBLIC_ prefix — this key must stay server-side.
# A MISSING key fails loudly (proxy.ts returns 503 for every route in production).
# A WRONG key fails SILENTLY: decryptField swallows the error and returns the raw
# `enc:` string, and saving that record then double-encrypts it.
ENCRYPTION_KEY=

# --- Recommended (warned if missing) ---
NEXT_PUBLIC_APP_URL=
RESEND_API_KEY=
EMAIL_FROM_DOMAIN=
EMAIL_REPLY_TO=

# --- Square ---
SQUARE_ACCESS_TOKEN=
SQUARE_ENVIRONMENT=sandbox
SQUARE_APPLICATION_ID=
SQUARE_LOCATION_ID=
SQUARE_WEBHOOK_SIGNATURE_KEY=
# Sandbox invoice recipient override. MUST be set on any non-production
# environment — src/lib/square/invoices.ts otherwise falls back to a real address.
SQUARE_DEV_EMAIL=

# --- Rate limiting (optional; gracefully disabled when unset) ---
# The Vercel Marketplace Upstash integration injects KV_REST_API_* instead.
# Note the Redis key prefixes are global, so environments sharing one instance
# also share rate-limit buckets.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- AI help assistant (chat hides itself when absent) ---
ANTHROPIC_API_KEY=
HELP_AI_MODEL=

# --- Cron ---
CRON_SECRET=

# --- Supabase Management API (migrations, cert refresh, unpausing) ---
SUPABASE_ACCESS_TOKEN=
PROD_SUPABASE_DB_PASSWORD=
DEV_SUPABASE_DB_PASSWORD=

# --- Cert environment (scripts/cert-refresh) ---
# PRODUCTION's ENCRYPTION_KEY, verbatim — cert's PHI only decrypts under it.
CERT_ENCRYPTION_KEY=
# Comma-separated emails that keep a real address on cert so testers can sign in.
CERT_TESTERS=
CERT_TESTER_PASSWORD=
# Optional; defaults to cert.mca.invalid (.invalid can never resolve).
CERT_SINK_DOMAIN=

# --- Local-only auto-login ---
# Signs unauthenticated local requests in as a seeded dev account. Gated on
# NODE_ENV=development + this flag + the Supabase ref + TEST_USER_PASSWORD.
# Leave UNSET while local dev points at cert: cert holds real PHI, and the only
# remaining barrier would be NODE_ENV.
# DEV_AUTO_LOGIN=1
TEST_USER_PASSWORD=
