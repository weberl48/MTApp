# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/
/tests/.auth/
/.playwright-mcp/
audit-*.png

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# dev portal local data (error feed + health history)
/tools/dev-portal/data/

# generated dev-seed SQL (reproducible via scripts/dev-seed/generate.mjs)
/scripts/dev-seed/dev-seed.sql

# typescript
*.tsbuildinfo
next-env.d.ts

# Local backup-script failure log (written when the backup drive is unavailable)
backup-failures.log
