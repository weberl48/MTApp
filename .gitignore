# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/
/tests/.auth/
/.playwright-mcp/
audit-*.png
# walkthrough audit output — screenshots can contain real cert data
/.walkthrough-audit*/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the template must be committable — README.md tells you to copy it,
# and the blanket rule above is why it never existed.
!.env.example

# vercel
.vercel

# dev portal local data (error feed + health history)
/tools/dev-portal/data/

# generated dev-seed SQL (reproducible via scripts/dev-seed/generate.mjs)
/scripts/dev-seed/dev-seed.sql

# typescript
*.tsbuildinfo
next-env.d.ts

# Local backup-script failure log (written when the backup drive is unavailable)
backup-failures.log

# ----------------------------------------------------------------------------
# Real-data artifacts. THIS REPO IS PUBLIC, and cert holds a full copy of
# production including real client names, so anything rendered from the running
# app or exported from the owner's records is PHI. Same reasoning as the
# walkthrough-audit rule above, applied to the places real data actually lands.
#
# The root-anchored patterns deliberately do NOT match nested paths, so genuine
# assets (public/icons, docs illustrations) stay committable.
# ----------------------------------------------------------------------------
/docs/feature-tour/
# The BUILT onboarding guide inlines every screenshot as base64, so the artifact
# carries whatever those screenshots contain — ignoring the screenshot folders
# above does nothing if the rendered output is committed. `guide-src.html` stays
# tracked: it holds only {{SS}}/name.png placeholders. Rebuild locally with
# `node scripts/build-onboarding-guide.mjs` and send the file directly.
/docs/onboarding/MCA-Admin-Onboarding-Guide.html
/docs/onboarding/MCA-Admin-Onboarding-Guide.pdf
# Screenshots of the running app for the admin guide — same real-client-name risk.
/docs/admin-guide/
/*.png
/*.jpg
/*.jpeg
/*.pdf
/*.xlsx
/*.xls
/*.csv
/.dev-server.log

# Legacy/reference copy of the app — see CLAUDE.md; not part of the build.
/mca-app/

# Local agent tooling — machine-specific, not project content.
/.claude/settings.local.json
/skill-observations/
